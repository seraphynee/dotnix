#!/bin/sh
set -eu

kind=${1-}
value=${2-}
[ -n "$kind" ] && [ -n "$value" ] || exit 1

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null) || exit 1
if [ "$current_branch" = HEAD ]; then
    current_branch=$(git describe --exact-match --tags 2>/dev/null || git rev-parse --short HEAD 2>/dev/null) || exit 1
fi

remote=
case "$kind" in
commit)
    web_path="/commit/$value"
    ;;
branch)
    current_branch=$value
    remote=$(git config --get "branch.$current_branch.remote" 2>/dev/null || :)
    remote_candidate=${current_branch%%/*}
    if [ -z "$remote" ] && [ "$remote_candidate" != "$current_branch" ] &&
        git remote get-url "$remote_candidate" >/dev/null 2>&1; then
        remote=$remote_candidate
        current_branch=${current_branch#*/}
    fi
    web_path="/tree/$current_branch"
    ;;
remote)
    remote=$value
    web_path="/tree/$current_branch"
    ;;
file)
    prefix=$(git rev-parse --show-prefix 2>/dev/null) || exit 1
    web_path="/blob/$current_branch/$prefix$value"
    ;;
tag)
    web_path="/releases/tag/$value"
    ;;
*)
    exit 1
    ;;
esac

if [ -z "$remote" ]; then
    remote=$(git config --get "branch.$current_branch.remote" 2>/dev/null || :)
    [ -n "$remote" ] || remote=origin
fi

remote_url=$(git remote get-url "$remote" 2>/dev/null) || exit 1
remote_url=${remote_url%.git}

ssh_host=
remote_path=
case "$remote_url" in
http://*|https://*)
    case "$remote_url" in
    http://*/*|https://*/*) ;;
    *) exit 1 ;;
    esac
    https_authority=${remote_url#*://}
    https_authority=${https_authority%%/*}
    case "$https_authority" in
    *@*) exit 1 ;;
    esac
    ;;
ssh://*)
    authority_path=${remote_url#ssh://}
    authority=${authority_path%%/*}
    [ "$authority_path" != "$authority" ] || exit 1
    remote_path=${authority_path#*/}
    [ -n "$remote_path" ] || exit 1
    authority=${authority##*@}
    case "$authority" in
    *:*) ssh_host=${authority%%:*} ;;
    *) ssh_host=$authority ;;
    esac
    [ -n "$ssh_host" ] || exit 1
    ;;
*:*/*)
    case "$remote_url" in
    *://*) exit 1 ;;
    esac
    ssh_host=${remote_url%%:*}
    remote_path=${remote_url#*:}
    ssh_host=${ssh_host##*@}
    [ -n "$ssh_host" ] && [ -n "$remote_path" ] || exit 1
    ;;
*)
    exit 1
    ;;
esac

case "$remote_url" in
ssh://*|*:*/*)
    web_host=$ssh_host
    if command -v ssh >/dev/null 2>&1 && command -v awk >/dev/null 2>&1; then
        configured_host=$(ssh -G "$ssh_host" 2>/dev/null | awk '$1 == "hostname" { print $2; exit }') || :
        [ -n "${configured_host-}" ] && web_host=$configured_host
    fi
    remote_url="https://$web_host/$remote_path"
    ;;
esac

url=$remote_url$web_path
case "$(uname -s 2>/dev/null || :)" in
Darwin)
    command -v open >/dev/null 2>&1 || exit 1
    exec open "$url"
    ;;
*)
    command -v xdg-open >/dev/null 2>&1 || exit 1
    exec xdg-open "$url"
    ;;
esac
