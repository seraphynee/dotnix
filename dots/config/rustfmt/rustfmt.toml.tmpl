# Edition
edition = "2021"
style_edition = "2024"

# Indentation
hard_tabs = false
tab_spaces = 4

# Imports
reorder_imports = true
reorder_modules = true

# Widths
max_width = 100
chain_width = 80
array_width = 80
fn_call_width = 80
attr_fn_like_width = 70

# Layout
trailing_comma = "Vertical"
brace_style = "SameLineWhere"
match_arm_blocks = true

# Comments and strings
comment_width = 100
wrap_comments = true
format_strings = true

# Macros
format_macro_bodies = true
format_macro_matchers = true
