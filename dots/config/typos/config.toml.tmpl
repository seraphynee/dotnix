# ============================================================
# 1. File-level settings
# ============================================================
[files]
# Gitignore-style globs to ignore files/directories globally
extend-exclude = [
  # Dependencies & build artifacts
  "node_modules/",
  "vendor/",
  "dist/",
  "build/",
  ".next/",
  "out/",
  "coverage/",
  "*.min.js",
  "*.min.css",

  # Lock files & binaries
  "package-lock.json",
  "pnpm-lock.yaml",
  "yarn.lock",
  "Cargo.lock",
  "*.lock",
  "*.bin",
  "*.exe",
  "*.dll",
  "*.so",
  "*.dylib",

  # Generated / vendored code
  "generated/",
  "codegen/",
  "proto/",
  "openapi/",
  "swagger/",
  "graphql_generated/",

  # Localization & data files with many false positives
  "public/locales/",
  "i18n/",
  "**/*.po",
  "**/*.mo",
  "data/*.json",
  "fixtures/",
  "mocks/",

  # Secrets & keys (should not be scanned)
  "*env*",
  ".env*",
  "*.pem",
  "*.key",
  "*.crt",
  "*.pub",
]

# ============================================================
