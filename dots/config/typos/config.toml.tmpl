# Regex patterns for identifiers to always ignore
[default]
extend-ignore-identifiers-re = [
  # All identifiers matching "AttributeID...Supress..."
  "AttributeID.*Supress.*",
  # All Stripe webhook handlers
  "handleStripe.*Webhook.*",
  # All identifiers starting with "legacy"
  "legacy.*",
  # All identifiers ending with a digit (e.g. v1, v2, api2)
  ".*[0-9]$",
]

# ============================================================
# 3. Per-file-type overrides
# ============================================================

# Translation files (only check filenames, not contents)
[type.po]
extend-glob = ["*.po", "*.mo"]
check-file = false

# JSON files in i18n / locales folders
[type.i18n]
extend-glob = [
  "i18n/**/*.json",
  "public/locales/**/*.json",
  "src/locales/**/*.json",
]
check-file = false

# Markdown files (documentation) – keep checking but can be relaxed if needed
[type.md]
extend-glob = ["*.md", "*.mdx"]
# check-file = false

# Config files (often have weird keys)
[type.config]
extend-glob = [
  "*.config.js",
  "*.config.ts",
  "*.config.mjs",
  "vite.config.*",
  "next.config.*",
  "tailwind.config.*",
  "eslint.config.*",
  "prettier.config.*",
  "tsconfig.*",
  "jsconfig.*",
]
check-file = false

# Generated GraphQL / OpenAPI files
[type.generated]
extend-glob = [
  "generated/**/*.ts",
  "codegen/**/*.ts",
  "graphql/**/*.ts",
  "openapi/**/*.ts",
  "swagger/**/*.ts",
]
check-file = false

# Lock & vendor files (extra safety, though already excluded)
[type.lock]
extend-glob = [
  "*.lock",
  "package-lock.json",
  "pnpm-lock.yaml",
  "yarn.lock",
  "Cargo.lock",
]
check-file = false

# ============================================================
# 4. Overrides for specific folders (optional)
# ============================================================

# Test files – often use "foo", "bar", "baz"
[type.tests]
extend-glob = [
  "**/*.test.ts",
  "**/*.test.tsx",
  "**/*.spec.ts",
  "**/*.spec.tsx",
  "tests/**/*.ts",
  "tests/**/*.tsx",
  "__tests__/**/*.ts",
  "__tests__/**/*.tsx",
]
# You can add test-specific words here if needed:
# [type.tests.extend-words]
# foo = "foo"
# bar = "bar"
# baz = "baz"

# Internal scripts / tooling
[type.scripts]
extend-glob = [
  "scripts/**/*.ts",
  "scripts/**/*.js",
  "tools/**/*.ts",
  "tools/**/*.js",
]
# Can be relaxed if many internal names are used
