;; Kanata entrypoint.
;; Keep global settings, constants, and the physical layout here.
;; Feature-specific configuration lives in parts/.

;; Global configuration applied to all layers.
(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes ;; For input chording/combos.
  danger-enable-cmd yes

  ;; Uncomment this section on macOS to prevent Kanata from stopping after sleep.

  ;; macos-dev-names-exclude (
  ;;   "Corne"
  ;;   "kbdksp/geulisv1"
  ;; )

  ;; macos-dev-names-include (
  ;;   "Chian's Magic Keyboard"
  ;; )

)

;; Timing and chord constants.
(defvar
  tap-time 200
  hold-time 200
  input-chord-time 250
)

;; Physical keyboard layout.
(defsrc
       f1  f2  f3  f4  f5  f6  f7  f8  f9  f10  f11  f12
  grv  1  2  3  4  5  6  7  8  9  0  -  =  bspc
  tab  q  w  e  r  t  y  u  i  o  p  [  ]  \
  caps  a  s  d  f  g  h  j  k  l  ;  '  ret
  lsft  z  x  c  v  b  n  m  ,  .  /  rsft
  lctl  lmet  lalt  spc  ralt  rmet  rctl
)

;; Include order matters: core defines aliases used by the feature layers.
(include "parts/chords.kbd")
(include "parts/core.kbd")
(include "parts/tmux.kbd")
(include "parts/herdr.kbd")
(include "parts/zellij.kbd")

@conditional_raycast_include@
